"{\"cells\": [{\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"# Local Whisper w Colab \\u2014 warsztat BrainHack 2026\\n\", \"\\n\", \"Cz\\u0119\\u015b\\u0107 warsztatowa modu\\u0142u **4 (Ochrona danych i modele lokalne)**.\\n\", \"\\n\", \"Uruchamiaj kom\\u00f3rki kolejno (`Shift+Enter`). W\\u0142asne nagranie (~1 min) wgraj w kom\\u00f3rce 1.\\n\"]}, {\"cell_type\": \"code\", \"execution_count\": null, \"metadata\": {}, \"outputs\": [], \"source\": [\"# 0. Instalacja\\n\", \"!pip install -q faster-whisper jiwer\\n\", \"import sys, os\"]}, {\"cell_type\": \"code\", \"execution_count\": null, \"metadata\": {}, \"outputs\": [], \"source\": [\"# 1. Wgraj w\\u0142asne nagranie (~1 min)\\n\", \"from google.colab import files\\n\", \"uploaded = files.upload()\\n\", \"AUDIO = list(uploaded.keys())[0]\\n\", \"print('Wgrano:', AUDIO)\"]}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## 2. Transkrypcja (speech-to-text) \\u2014 faster-whisper\\n\", \"\\n\", \"Model dzia\\u0142a lokalnie na maszynie Colab \\u2014 audio nie opuszcza tej sesji.\\n\"]}, {\"cell_type\": \"code\", \"execution_count\": null, \"metadata\": {}, \"outputs\": [], \"source\": [\"from faster_whisper import WhisperModel\\n\", \"\\n\", \"model = WhisperModel('small', device='cpu', compute_type='int8')  # na GPU: device='cuda', compute_type='float16'\\n\", \"segments, info = model.transcribe(AUDIO, language='pl')\\n\", \"\\n\", \"lines = []\\n\", \"for seg in segments:\\n\", \"    lines.append(f'[{seg.start:6.1f}s -> {seg.end:6.1f}s] {seg.text.strip()}')\\n\", \"    print(lines[-1])\"]}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## 3. Zapisanie do pliku (txt + SRT)\\n\"]}, {\"cell_type\": \"code\", \"execution_count\": null, \"metadata\": {}, \"outputs\": [], \"source\": [\"base = os.path.splitext(AUDIO)[0]\\n\", \"\\n\", \"# zwyk\\u0142y tekst\\n\", \"with open(f'{base}_transkrypcja.txt', 'w', encoding='utf-8') as f:\\n\", \"    f.write('\\\\n'.join(l.split('] ',1)[1] for l in lines))\\n\", \"\\n\", \"# SRT (napisy)\\n\", \"def fmt(t):\\n\", \"    h, rem = divmod(t, 3600); m, s = divmod(rem, 60)\\n\", \"    return f'{int(h):02}:{int(m):02}:{int(s):02},{int((s%1)*1000):03}'\\n\", \"\\n\", \"with open(f'{base}.srt', 'w', encoding='utf-8') as f:\\n\", \"    for i, seg in enumerate(segments if 'segments' in dir() else [], 1):\\n\", \"        pass  # TODO na warsztacie: prawid\\u0142owy zapis SRT\\n\", \"\\n\", \"files.download(f'{base}_transkrypcja.txt')  # pobierz na dysk\\n\", \"print('Zapisano:', f'{base}_transkrypcja.txt')\"]}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## 4. Metryki: WER / CER\\n\", \"\\n\", \"**WER** = (S + D + I) / N \\u2014 substitutions, deletions, insertions / liczba s\\u0142\\u00f3w ref.\\n\", \"**CER** \\u2014 to samo na poziomie znak\\u00f3w.\\n\"]}, {\"cell_type\": \"code\", \"execution_count\": null, \"metadata\": {}, \"outputs\": [], \"source\": [\"from jiwer import wer, cer\\n\", \"\\n\", \"reference = \\\"TU WKLEJ MANUSKRYPT\\\"  # r\\u0119czna transkrypcja nagrania\\n\", \"hypothesis = '\\\\n'.join(l.split('] ',1)[1] for l in lines)\\n\", \"\\n\", \"print(f'WER: {wer(reference, hypothesis):.1%}')\\n\", \"print(f'CER: {cer(reference, hypothesis):.1%}')\"]}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## 5. Diaryzacja (kto m\\u00f3wi, kiedy)\\n\", \"\\n\", \"Opcja A: **WhisperX** (ASR + diaryzacja w jednym). Opcja B: pyannote (wymaga HF token).\\n\", \"\\n\", \"https://github.com/m-bain/whisperX\\n\"]}, {\"cell_type\": \"code\", \"execution_count\": null, \"metadata\": {}, \"outputs\": [], \"source\": [\"# TODO na warsztacie: WhisperX lub pyannote\\n\", \"# !pip install whisperx\\n\", \"# import whisperx\\n\", \"\\n\", \"print('TODO: diaryzacja \\u2014 przewodnik w docs/04_local_whisper.md')\"]}, {\"cell_type\": \"markdown\", \"metadata\": {}, \"source\": [\"## 6. Por\\u00f3wnanie z API (ElevenLabs)\\n\", \"\\n\", \"Wr\\u00f3\\u0107 do wynik\\u00f3w z bloku API (modu\\u0142 2) \\u2014 por\\u00f3wnaj: jako\\u015b\\u0107, czas, i **gdzie posz\\u0142y dane**.\\n\"]}], \"metadata\": {\"colab\": {\"provenance\": []}, \"kernelspec\": {\"display_name\": \"Python 3\", \"language\": \"python\", \"name\": \"python3\"}, \"language_info\": {\"name\": \"python\", \"version\": \"3.12\"}}, \"nbformat\": 4, \"nbformat_minor\": 5}"